          ],
          "minutes": 3.0,
          "source_slides": [
            6,
            7
          ],
          "content": [
            "Find the reference angle for 580°."
          ],
          "instructor_notes": [
            "Pause before revealing the solution."
          ],
          "verification": [],
          "answer": [
            "$580-360=220^\\circ$, so the QIII reference angle is 40°."
          ]
        },
        {
          "id": "math130unit3b-u3b-reference-feedback",
          "title": "Check and Diagnose: find reference angles in degrees and radians",
          "phase": "feedback",
