          "source_slides": [
            13
          ],
          "content": [
            "For $P=(-3,4)$, calculate r and all six trigonometric values."
          ],
          "instructor_notes": [],
          "verification": [
            "Verify exact values and quadrant signs."
          ],
          "steps": [
            "$r=\\sqrt{(-3)^2+4^2}=5$.",
            "$\\sin\\theta=4/5$, $\\cos\\theta=-3/5$, $\\tan\\theta=-4/3$.",
            "$\\csc\\theta=5/4$, $\\sec\\theta=-5/3$, $\\cot\\theta=-3/4$."
          ],
          "audit_checks": [
            "u3b-values"
          ]
        },
        {
          "id": "math130unit3b-u3b-values-practice",
          "title": "You Try: find exact trigonometric values from points and reference angles",
          "phase": "practice",
