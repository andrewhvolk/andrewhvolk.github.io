          "content": [
            "Reference angles are measured to the nearest x-axis.",
            "First find a coterminal angle when the original lies outside one rotation."
          ],
          "instructor_notes": [],
          "verification": []
        },
        {
          "id": "math130unit3b-u3b-reference-model",
          "title": "Model the Skill: find reference angles in degrees and radians",
          "phase": "model",
          "component": "derivation",
          "objectives": [
            "u3b-reference"
