          "minutes": 3.0,
          "source_slides": [],
          "content": [
            "Determine the quadrant if $\\tan\\theta>0$ and $\\cos\\theta<0$."
          ],
          "instructor_notes": [],
          "verification": [],
          "steps": [
            "Tangent is positive in Quadrants I and III.",
            "Cosine is negative in Quadrants II and III.",
            "The intersection is Quadrant III."
          ],
          "audit_checks": [
            "u3b-signs"
          ]
        },
        {
          "id": "math130unit3b-u3b-signs-practice",
