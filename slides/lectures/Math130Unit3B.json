          "minutes": 3.0,
          "source_slides": [
            5
          ],
          "content": [
            "Find reference angles for $150^\\circ$, $310^\\circ$, $-120^\\circ$, and $7\\pi/4$."
          ],
          "instructor_notes": [],
          "verification": [],
          "steps": [
            "$150^\\circ$ has reference angle $30^\\circ$; $310^\\circ$ has $50^\\circ$.",
            "$-120^\\circ$ is coterminal with $240^\\circ$, so its reference angle is $60^\\circ$.",
            "$7\\pi/4$ has reference angle $\\pi/4$."
          ],
          "audit_checks": [
            "u3b-reference"
          ]
        },
        {
          "id": "math130unit3b-u3b-reference-practice",
          "title": "You Try: find reference angles in degrees and radians",
          "phase": "practice",
