{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrewhvolk.github.io/slides/lectures/lecture-manifest.schema.json",
  "title": "MATH 130 lecture manifest",
  "type": "object",
  "required": ["version", "deck", "objectives", "sessions", "source_disposition"],
  "properties": {
    "version": { "const": 1 },
    "deck": {
      "type": "object",
      "required": ["id", "title", "section", "source", "canonical"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "section": { "type": "string" },
        "source": { "type": "string", "pattern": "\\.pptx$" },
        "canonical": { "const": true },
        "chooser_output": { "type": "string", "pattern": "\\.html$" }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "output", "duration_minutes", "min_slides", "max_slides", "rehearsal", "pilot", "blocks"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "output": { "type": "string", "pattern": "\\.html$" },
          "duration_minutes": { "type": "integer", "minimum": 1 },
          "min_slides": { "type": "integer", "minimum": 1 },
          "max_slides": { "type": "integer", "maximum": 35 },
          "rehearsal": {
            "type": "object",
            "required": [
              "status", "planned_instruction_minutes", "reserved_buffer_minutes",
              "available_flex_minutes", "stopping_points"
            ],
            "properties": {
              "status": { "const": "pending_live_rehearsal" },
              "planned_instruction_minutes": { "type": "number", "minimum": 1 },
              "reserved_buffer_minutes": { "type": "number", "minimum": 5 },
              "available_flex_minutes": { "type": "number", "minimum": 5 },
              "stopping_points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["after_block", "planned_elapsed", "action"],
                  "properties": {
                    "after_block": { "type": "string" },
                    "planned_elapsed": { "type": "number", "minimum": 0 },
                    "action": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "pilot": {
            "type": "object",
            "required": ["candidate", "status"],
            "properties": {
              "candidate": { "type": "boolean" },
              "status": { "const": "pending_classroom_use" }
            }
          },
          "blocks": {
            "type": "array",
            "items": { "$ref": "#/$defs/block" }
          }
        }
      }
    },
    "source_disposition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide", "disposition"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "disposition": { "enum": ["mapped", "omitted"] },
          "block": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id", "title", "phase", "component", "objectives",
        "minutes", "source_slides", "content"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "not": { "pattern": "(?i)continued" } },
        "phase": {
          "enum": ["activate", "explain", "model", "practice", "feedback", "synthesize"]
        },
        "component": {
          "enum": [
            "title", "chapter", "roadmap", "concept", "formula",
            "derivation", "diagram", "comparison", "decision",
            "worked-example", "practice", "misconception", "poll", "summary"
          ]
        },
        "objectives": { "type": "array", "items": { "type": "string" } },
        "minutes": { "type": "number", "minimum": 0 },
        "source_slides": { "type": "array", "items": { "type": "integer" } },
        "content": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "type": "string" } },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "alt"],
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string", "minLength": 1 }
            }
          }
        },
        "table": {
          "type": "object",
          "required": ["headers", "rows"],
          "properties": {
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "optional": { "type": "boolean" },
        "instructor_notes": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } }
        ,"audit_checks": { "type": "array", "items": { "type": "string" } }
        ,"pacing_checkpoint": { "type": "string" }
      }
    }
  }
}
