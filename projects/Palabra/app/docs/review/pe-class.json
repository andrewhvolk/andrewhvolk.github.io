  "lessons": [
    {
      "id": "lesson-pe.objects",
      "version": 1,
      "objectiveIds": [
        "pe.objects"
      ],
      "explanation": "Use ¿Qué significa…? to ask for a meaning and ¿Cómo se dice…? for how to say something. Learn object nouns together with an article.",
      "examples": [
        "¿Qué significa libro?",
        "El lápiz está aquí. = The pencil is here."
      ],
      "commonMistakes": [
        "Lápiz is masculine; mochila is feminine. Their articles are part of the phrase."
      ],
      "sourceRefs": [
        "https://www.rae.es/dpd/",
        "https://www.ixl.com/spanish/skill-plans/realidades-level-1.pdf",
        "https://passporttolanguages.net/realidades-1-outline"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra lesson; grammatical rules checked against RAE references. Author review, 2026-10-30; no independent teacher audit."
    },
    {
      "id": "lesson-pe.spelling",
      "version": 1,
      "objectiveIds": [
        "pe.spelling"
      ],
      "explanation": "Spanish letter names help you spell aloud. Hache is silent in words; eñe is a separate letter. Modern names include be, uve and ye; regional names also occur.",
      "examples": [
        "Ana: a, ene, a.",
        "año: a, eñe, o."
      ],
      "commonMistakes": [
        "The letter ñ is not n with an optional accent: año and ano are different words."
      ],
      "sourceRefs": [
        "https://www.rae.es/dpd/abecedario",
        "https://www.ixl.com/spanish/skill-plans/realidades-level-1.pdf",
        "https://passporttolanguages.net/realidades-1-outline"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra lesson; grammatical rules checked against RAE references. Author review, 2026-10-30; no independent teacher audit."
    },
    {
      "id": "lesson-pe.dates",
      "version": 1,
      "objectiveIds": [
        "pe.dates"
      ],
      "explanation": "Dates usually put the day before the month: el dos de mayo. Days and months use lowercase. Primero is conventional for the first of a month; uno also occurs.",
      "examples": [
        "Hoy es lunes.",
        "Es el primero de junio."
      ],
      "commonMistakes": [
        "Do not capitalize months as English normally does."
      ],
      "sourceRefs": [
        "https://www.rae.es/dpd/fecha",
        "https://www.ixl.com/spanish/skill-plans/realidades-level-1.pdf",
        "https://passporttolanguages.net/realidades-1-outline"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra lesson; grammatical rules checked against RAE references. Author review, 2026-10-30; no independent teacher audit."
    },
    {
      "id": "lesson-pe-class.reading",
      "version": 1,
      "objectiveIds": [
        "pe-class.reading"
      ],
      "explanation": "Read the question first. Find the sentence that gives that detail, and check who, when or where it describes.",
      "examples": [
        "¿Quién? Look for the person.",
        "¿Cuándo? Look for the time or day."
      ],
      "commonMistakes": [
        "A familiar word alone may not answer the question. Check the whole message."
      ],
      "sourceRefs": [
        "https://www.coe.int/en/web/common-european-framework-reference-languages"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra strategy lesson; author review, not an independent educator audit."
    },
    {
      "id": "lesson-pe-class.listening",
      "version": 1,
      "objectiveIds": [
        "pe-class.listening"
      ],
      "explanation": "Read the question, then listen for its detail. Replay as needed. Reading the transcript makes it supported practice.",
      "examples": [
        "Listen for names, numbers and places.",
        "Replay a short phrase before opening the transcript."
      ],
      "commonMistakes": [
        "A familiar word alone may not answer the question. Check the whole message."
      ],
      "sourceRefs": [
        "https://www.coe.int/en/web/common-european-framework-reference-languages"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra strategy lesson; author review, not an independent educator audit."
    }
  ],
  "stimuli": [
    {
      "id": "read-pe-class",
      "kind": "reading",
      "chapterId": "pe-class",
      "SpanishText": "En mi mochila hay un libro, dos lápices y un cuaderno. El libro es de español. En el cuaderno hay una fecha: el dos de mayo. Hoy es lunes. Mi amiga se llama Ana: a, ene, a. En la clase digo «¿Qué significa ventana?». La profesora dice «Window». Yo digo «Más despacio, por favor». En la mesa hay una mochila azul.",
      "glossary": {
        "hay": "there is / there are",
        "hoy": "today",
        "mochila": "backpack",
        "cuaderno": "notebook",
        "ventana": "window"
      },
      "sourceRefs": [],
      "reviewStatus": "reviewed",
      "provenance": "Original fictional passage, authored for Palabra. Not a textbook reading."
    },
    {
      "id": "audio-pe-class",
      "kind": "listening",
      "chapterId": "pe-class",
      "SpanishText": "En mi mochila hay tres libros.",
      "transcript": "En mi mochila hay tres libros.",
