  "lessons": [
    {
      "id": "lesson-1b.articles",
      "version": 1,
      "objectiveIds": [
        "1b.articles"
      ],
      "explanation": "El/la are singular definite articles (the); un/una are singular indefinite articles (a). Match grammatical gender, which is not always predictable from the final letter.",
      "examples": [
        "El libro; un libro.",
        "La mano; una mano."
      ],
      "commonMistakes": [
        "La mano is feminine and el día is masculine. Learn exceptions with their articles."
      ],
      "sourceRefs": [
        "https://www.rae.es/dpd/el",
        "https://www.rae.es/dpd/una",
        "https://www.ixl.com/spanish/skill-plans/realidades-level-1.pdf",
        "https://passporttolanguages.net/realidades-1-outline"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra lesson; grammatical rules checked against RAE references. Author review, 2026-10-30; no independent teacher audit."
    },
    {
      "id": "lesson-1b.adjectives",
      "version": 1,
      "objectiveIds": [
        "1b.adjectives"
      ],
      "explanation": "Most descriptive adjectives follow their noun. Adjectives ending in -o change to -a for a feminine noun. Many adjectives ending in -e, such as inteligente, do not change for gender.",
      "examples": [
        "Una chica simpática.",
        "Un chico inteligente."
      ],
      "commonMistakes": [
        "Match the person described, not the speaker. Not every adjective uses -o/-a."
      ],
      "sourceRefs": [
        "https://www.rae.es/dpd/concordancia",
        "https://www.ixl.com/spanish/skill-plans/realidades-level-1.pdf",
        "https://passporttolanguages.net/realidades-1-outline"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra lesson; grammatical rules checked against RAE references. Author review, 2026-10-30; no independent teacher audit."
    },
    {
      "id": "lesson-1b.reading",
      "version": 1,
      "objectiveIds": [
        "1b.reading"
      ],
      "explanation": "Read the question first. Find the sentence that gives that detail, and check who, when or where it describes.",
      "examples": [
        "¿Quién? Look for the person.",
        "¿Cuándo? Look for the time or day."
      ],
      "commonMistakes": [
        "A familiar word alone may not answer the question. Check the whole message."
      ],
      "sourceRefs": [
        "https://www.coe.int/en/web/common-european-framework-reference-languages"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra strategy lesson; author review, not an independent educator audit."
    },
    {
      "id": "lesson-1b.listening",
      "version": 1,
      "objectiveIds": [
        "1b.listening"
      ],
      "explanation": "Read the question, then listen for its detail. Replay as needed. Reading the transcript makes it supported practice.",
      "examples": [
        "Listen for names, numbers and places.",
        "Replay a short phrase before opening the transcript."
      ],
      "commonMistakes": [
        "A familiar word alone may not answer the question. Check the whole message."
      ],
      "sourceRefs": [
        "https://www.coe.int/en/web/common-european-framework-reference-languages"
      ],
      "reviewStatus": "reviewed",
      "provenance": "Original Palabra strategy lesson; author review, not an independent educator audit."
    }
  ],
  "stimuli": [
    {
      "id": "read-1b",
      "kind": "reading",
      "chapterId": "1b",
      "SpanishText": "Mi amiga se llama Elena. Es una chica simpática y muy trabajadora. Le gusta estudiar y escuchar música. Mi amigo Luis es un chico reservado. Es paciente e inteligente. Le gusta dibujar. Elena no es reservada. Luis no es perezoso. En la clase hay una profesora amable. La profesora dice «Elena es artística y Luis es deportista». Elena es buena amiga. Luis también.",
      "glossary": {
        "hay": "there is / there are",
        "también": "also"
      },
      "sourceRefs": [],
      "reviewStatus": "reviewed",
      "provenance": "Original fictional passage, authored for Palabra. Not a textbook reading."
    },
